<Window x:Class="DroneSoccerWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DroneSoccerWPF"
        Title="Tello EDU Controller"
        Height="960" Width="1280"
        MinHeight="820" MinWidth="1100"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        Background="#121418"
        Foreground="#F2F4F8"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        PreviewKeyDown="Window_PreviewKeyDown"
        PreviewKeyUp="Window_PreviewKeyUp"
        KeyboardNavigation.DirectionalNavigation="None"
        KeyboardNavigation.TabNavigation="Continue">
    <Window.Resources>
        <Style x:Key="Cmd" TargetType="Button">
            <Setter Property="Foreground" Value="#F2F4F8"/>
            <Setter Property="Background" Value="#2E3646"/>
            <Setter Property="BorderBrush" Value="#4A5568"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="#F2F4F8"/>
            <Setter Property="Margin" Value="0,0,16,0"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Tello EDU" FontSize="22" FontWeight="SemiBold"/>
                <TextBlock Text="Ryze Tech (Powered by DJI)  ·  TLW004  ·  Intel Movidius Myriad 2 VPU"
                           Foreground="#9AA3B2" Margin="0,2,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                <TextBlock x:Name="BridgeStatusText"
                           Text="Python idle. Manual flight does not need it."
                           Foreground="#9AA3B2" HorizontalAlignment="Right"/>
                <TextBlock x:Name="DroneStatusText"
                           Text="Drone idle"
                           Foreground="#9AA3B2" HorizontalAlignment="Right" Margin="0,4,0,0"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="420"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="210"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Grid.Column="0" Background="#0E1116" CornerRadius="12" ClipToBounds="True" MouseLeftButtonDown="Camera_MouseDown">
                <Grid>
                    <Image x:Name="CameraImage" Stretch="Uniform"/>
                    <TextBlock x:Name="VideoPlaceholder"
                               Text="Enter the drone IP and port, then press Connect drone."
                               Foreground="#9AA3B2" FontSize="16"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               TextAlignment="Center" TextWrapping="Wrap" Margin="28"/>
                    <Border x:Name="ObstacleBanner" Visibility="Collapsed"
                            HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,16,0,0"
                            Background="#FF5A6A" CornerRadius="6" Padding="14,8">
                        <TextBlock x:Name="ObstacleBannerText" Foreground="White" FontWeight="SemiBold"
                                   Text="Obstacle — forward motion cancelled, holding position"/>
                    </Border>
                    <Border HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="16"
                            Background="#CC10141C" CornerRadius="6" Padding="10,6">
                        <TextBlock x:Name="VideoHeightText" FontSize="16" Text="Altitude —"/>
                    </Border>
                    <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="16"
                            Background="#CC10141C" CornerRadius="6" Padding="10,6">
                        <TextBlock FontSize="13" TextWrapping="Wrap"
                                   Text="1  Takeoff&#x0a;2  Land&#x0a;Arrows  forward / back / left / right&#x0a;W / S  up / down&#x0a;A / D  turn left / right"/>
                    </Border>
                </Grid>
            </Border>

            <local:ExecutionPanel x:Name="ExecutionLog" Grid.Row="1" Grid.Column="0" Margin="0,12,0,0"/>

            <Border Grid.Row="0" Grid.Column="1" Grid.RowSpan="2" Background="#1C212B" CornerRadius="12" Padding="16" Margin="12,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <TextBlock Text="Controller" FontSize="16" FontWeight="SemiBold"/>
                        <Grid Margin="0,10,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="88"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Drone IP" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBox x:Name="DroneIpBox" Grid.Column="1" Text="192.168.10.1"
                                     Height="32" VerticalContentAlignment="Center" Padding="8,0"
                                     Background="#121418" Foreground="#F2F4F8" BorderBrush="#4A5568"
                                     FontSize="14"
                                     PreviewTextInput="DroneIpBox_PreviewTextInput"/>
                            <TextBlock Grid.Column="2" Text="Port" VerticalAlignment="Center" Margin="12,0,8,0"/>
                            <TextBox x:Name="DronePortBox" Grid.Column="3" Text="8889" MaxLength="5"
                                     Height="32" VerticalContentAlignment="Center" Padding="8,0"
                                     Background="#121418" Foreground="#F2F4F8" BorderBrush="#4A5568"
                                     FontSize="14" TextAlignment="Center"
                                     PreviewTextInput="DronePortBox_PreviewTextInput"/>
                        </Grid>
                        <TextBlock x:Name="LinkPortsText" Foreground="#9AA3B2" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8"
                                   Text="Aircraft command port is editable. This PC listens on state port 8890 and video port 11111."/>
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="ConnectDroneButton" Style="{StaticResource Cmd}" Content="Connect drone"
                                    Click="ConnectDrone_Click"/>
                            <Button x:Name="DisconnectDroneButton" Style="{StaticResource Cmd}" Content="Disconnect"
                                    Click="DisconnectDrone_Click" IsEnabled="False"/>
                            <Button Style="{StaticResource Cmd}" Content="Drone commands"
                                    Click="ShowCommands_Click"/>
                        </StackPanel>
                        <TextBlock Text="Record folder" Margin="0,4,0,4"/>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="RecordFolderBox" Height="32" VerticalContentAlignment="Center" Padding="8,0"
                                     Background="#121418" Foreground="#F2F4F8" BorderBrush="#4A5568" FontSize="13"/>
                            <Button Grid.Column="1" Style="{StaticResource Cmd}" Content="Browse" Margin="8,0,0,8"
                                    Click="BrowseRecordFolder_Click"/>
                        </Grid>
                        <WrapPanel>
                            <Button x:Name="SaveFolderButton" Style="{StaticResource Cmd}" Content="Save folder"
                                    Click="SaveFolder_Click"/>
                            <Button x:Name="OpenFolderButton" Style="{StaticResource Cmd}" Content="Open folder"
                                    Click="OpenRecordFolder_Click"/>
                            <Button x:Name="RecordVideoButton" Style="{StaticResource Cmd}" Content="Record video"
                                    Click="RecordVideo_Click" IsEnabled="False"/>
                        </WrapPanel>
                        <TextBlock Text="Videos" Margin="0,2,0,4"/>
                        <ListBox x:Name="RecordedVideoList" Height="120" Margin="0,0,0,8"
                                 Background="#121418" Foreground="#F2F4F8" BorderBrush="#4A5568"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 MouseDoubleClick="RecordedVideoList_MouseDoubleClick">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Foreground" Value="#F2F4F8"/>
                                    <Setter Property="Padding" Value="4,3"/>
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>
                        <Grid Margin="0,8,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="72"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="72"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Python IP" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBox x:Name="PythonIpBox" Grid.Column="1" Text="127.0.0.1"
                                     Height="32" VerticalContentAlignment="Center" Padding="8,0"
                                     Background="#121418" Foreground="#F2F4F8" BorderBrush="#4A5568"
                                     FontSize="14"
                                     PreviewTextInput="DroneIpBox_PreviewTextInput"/>
                            <TextBlock Grid.Column="2" Text="Result" VerticalAlignment="Center" Margin="12,0,8,0"/>
                            <TextBox x:Name="PythonControlPortBox" Grid.Column="3" Text="8765" MaxLength="5"
                                     Height="32" VerticalContentAlignment="Center" Padding="8,0"
                                     Background="#121418" Foreground="#F2F4F8" BorderBrush="#4A5568"
                                     FontSize="14" TextAlignment="Center"
                                     PreviewTextInput="DronePortBox_PreviewTextInput"/>
                            <TextBlock Grid.Column="4" Text="Video" VerticalAlignment="Center" Margin="12,0,8,0"/>
                            <TextBox x:Name="PythonVideoPortBox" Grid.Column="5" Text="8766" MaxLength="5"
                                     Height="32" VerticalContentAlignment="Center" Padding="8,0"
                                     Background="#121418" Foreground="#F2F4F8" BorderBrush="#4A5568"
                                     FontSize="14" TextAlignment="Center"
                                     PreviewTextInput="DronePortBox_PreviewTextInput"/>
                        </Grid>
                        <TextBlock Foreground="#9AA3B2" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8"
                                   Text="Manual flight does not use Python. Link only when a vision server is already running."/>
                        <WrapPanel>
                            <Button x:Name="LinkPythonButton" Style="{StaticResource Cmd}" Content="Link Python"
                                    Click="LinkPython_Click"/>
                            <Button x:Name="UnlinkPythonButton" Style="{StaticResource Cmd}" Content="Unlink Python"
                                    Click="UnlinkPython_Click" IsEnabled="False"/>
                            <Button x:Name="StartBridgeButton" Style="{StaticResource Cmd}" Content="Start Python server"
                                    Click="StartBridge_Click"/>
                            <Button x:Name="StopBridgeButton" Style="{StaticResource Cmd}" Content="Stop Python server"
                                    Click="StopBridge_Click" IsEnabled="False"/>
                        </WrapPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <RadioButton Content="Manual" IsChecked="True" GroupName="FlightMode"/>
                            <RadioButton Content="Automatic" IsEnabled="False" GroupName="FlightMode"/>
                        </StackPanel>
                        <TextBlock x:Name="ModeStatusText"
                                   Text="Manual sticks fly from this controller. Python is only needed for vision and reinforcement learning."
                                   Foreground="#9AA3B2" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"/>
                    </StackPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,12,0,12">
                        <StackPanel>
                            <WrapPanel>
                                <Button x:Name="TakeoffButton" Style="{StaticResource Cmd}" Content="Takeoff  1"
                                        Click="Takeoff_Click" IsEnabled="False"/>
                                <Button x:Name="LandButton" Style="{StaticResource Cmd}" Content="Land  2"
                                        Click="Land_Click" IsEnabled="False"/>
                                <Button x:Name="HoverButton" Style="{StaticResource Cmd}" Content="Hold  Space"
                                        Click="Hover_Click" IsEnabled="False"/>
                                <Button x:Name="EmergencyButton" Style="{StaticResource Cmd}" Content="Emergency"
                                        Background="#8C2F39" BorderBrush="#8C2F39"
                                        Click="Emergency_Click" IsEnabled="False"/>
                            </WrapPanel>

                            <DockPanel Margin="0,4,0,10">
                                <TextBlock DockPanel.Dock="Right" x:Name="SpeedValueText" Text="35" MinWidth="28" TextAlignment="Right"/>
                                <TextBlock DockPanel.Dock="Left" Text="Stick speed" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <Slider x:Name="SpeedSlider" Minimum="15" Maximum="70" Value="35"
                                        TickFrequency="5" IsSnapToTickEnabled="True" Focusable="False"
                                        ValueChanged="SpeedSlider_ValueChanged"/>
                            </DockPanel>

                            <TextBlock Foreground="#9AA3B2" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,12"
                                       Text="1 takes off. 2 lands. Sticks do nothing on the ground. After takeoff, arrow Up / Down fly forward and back, and arrow Left / Right move sideways. W climbs and S descends, 30 cm at a time. A turns left and D turns right.&#x0a;Space holds position. Keys do not fly while a text box is focused. Click the video, then fly."/>

                            <TextBlock x:Name="ObstacleStatusText" TextWrapping="Wrap" Margin="0,0,0,6"
                                       Text="Forward obstacles are judged from the camera. The downward ToF is for altitude."/>
                            <TextBlock x:Name="StickInText" Foreground="#9AA3B2" FontSize="12" Text="Input  L/R 0   F/B 0   U/D 0   Yaw 0"/>
                            <TextBlock x:Name="StickOutText" FontSize="12" Margin="0,2,0,12" Text="Output  L/R 0   F/B 0   U/D 0   Yaw 0"/>

                            <TextBlock Text="Values from the aircraft" FontWeight="SemiBold"/>
                            <TextBlock x:Name="TelemetryAgeText" Foreground="#9AA3B2" FontSize="12" Margin="0,2,0,8" Text="Waiting for data"/>
                            <StackPanel x:Name="TelemetryList">
                                <TextBlock Foreground="#9AA3B2" Text="No values received yet."/>
                            </StackPanel>

                            <TextBlock Text="Log" FontWeight="SemiBold" Margin="0,14,0,6"/>
                            <TextBlock x:Name="LogText" Foreground="#C5CAD3" FontSize="12" TextWrapping="Wrap"/>
                        </StackPanel>
                    </ScrollViewer>

                    <StackPanel Grid.Row="2">
                        <UniformGrid Columns="4" Margin="0,0,0,10">
                            <Border Background="#121418" CornerRadius="8" Padding="8" Margin="0,0,6,0" BorderBrush="#3DDC97" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="Altitude h" Foreground="#9AA3B2" FontSize="11"/>
                                    <TextBlock x:Name="AltitudeValueText" Text="—" FontSize="18" FontWeight="SemiBold" Foreground="#3DDC97"/>
                                </StackPanel>
                            </Border>
                            <Border Background="#121418" CornerRadius="8" Padding="8" Margin="0,0,6,0">
                                <StackPanel>
                                    <TextBlock Text="ToF" Foreground="#9AA3B2" FontSize="11"/>
                                    <TextBlock x:Name="TofValueText" Text="—" FontSize="18" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Border>
                            <Border Background="#121418" CornerRadius="8" Padding="8" Margin="0,0,6,0">
                                <StackPanel>
                                    <TextBlock Text="Baro" Foreground="#9AA3B2" FontSize="11"/>
                                    <TextBlock x:Name="BaroValueText" Text="—" FontSize="18" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Border>
                            <Border Background="#121418" CornerRadius="8" Padding="8">
                                <StackPanel>
                                    <TextBlock Text="Battery" Foreground="#9AA3B2" FontSize="11"/>
                                    <TextBlock x:Name="BatteryValueText" Text="—" FontSize="18" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <Border Background="#2A2418" BorderBrush="#FFB020" BorderThickness="1" CornerRadius="8" Padding="12">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="76"/>
                                        <ColumnDefinition Width="72"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Max height (cm)" FontWeight="SemiBold"/>
                                        <TextBlock Text="Save applies immediately, including in flight" Foreground="#9AA3B2" FontSize="11"/>
                                    </StackPanel>
                                    <TextBox x:Name="MaxHeightBox" Grid.Column="1" Text="150" MaxLength="4"
                                             Height="32" VerticalContentAlignment="Center" Padding="8,0"
                                             Background="#121418" Foreground="#F2F4F8" BorderBrush="#FFB020"
                                             FontSize="16" TextAlignment="Center"
                                             PreviewTextInput="MaxHeightBox_PreviewTextInput"
                                             KeyDown="MaxHeightBox_KeyDown"
                                             DataObject.Pasting="MaxHeightBox_Pasting"/>
                                    <Button x:Name="SaveHeightButton" Grid.Column="2" Style="{StaticResource Cmd}" Content="Save"
                                            Height="32" Margin="8,0,0,0" Padding="0"
                                            Background="#FFB020" Foreground="#1A1408" BorderBrush="#FFB020"
                                            FontWeight="SemiBold" Click="SaveHeight_Click"/>
                                </Grid>
                                <TextBlock x:Name="AppliedHeightText" Margin="0,8,0,0" Text="Applied 150 cm"/>
                                <TextBlock x:Name="HeightLimitStatusText" Foreground="#9AA3B2" FontSize="12" Margin="0,2,0,0"
                                           Text="50-1000 cm. Climb stops at the limit. If the aircraft is already above it, it descends slowly."/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
