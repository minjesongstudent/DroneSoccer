#!/usr/bin/env bash
#
# ds - one entry point for the Drone Soccer experiment workflow.
#
# Run it with no arguments for a status banner and the command list. It needs
# nothing but bash, so it behaves the same on a laptop and on the HPC login
# node. Every command wraps a script in hpc/, which stays usable on its own.

set -euo pipefail

# Act on the repo whatever directory the caller sits in.
cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")"

PY=.venv/bin/python
JOB=hpc/job.pbs
LAST=runs/.last-name

# The name of the most recent submission, so status and progress follow the run
# you actually started rather than whatever came before it.
name_default() { cat "$LAST" 2>/dev/null || echo sac; }

if [ -t 1 ]; then
  B=$'\033[1m'; D=$'\033[2m'; R=$'\033[31m'; G=$'\033[32m'; Y=$'\033[33m'; N=$'\033[0m'
else
  B=''; D=''; R=''; G=''; Y=''; N=''
fi

die()  { printf '%serror:%s %s\n' "$R" "$N" "$*" >&2; exit 1; }
warn() { printf '%swarning:%s %s\n' "$Y" "$N" "$*" >&2; }

have_venv() { [ -x "$PY" ]; }
need_venv() { have_venv || die "no .venv. Run: ./ds setup"; }
need_qsub() { command -v qsub >/dev/null 2>&1 || die "no qsub. Run this on the HPC login node."; }

# --- small readers ----------------------------------------------------------

# Total walltime of a job (default: the first one listed), in minutes. ds submit
# sets the walltime on the qsub command line, so the #PBS line in the job file
# is only a fallback.
walltime_min() {
  local w h m id=${1:-}
  [ -n "$id" ] || id=$(job_rows | awk 'NR==1{print $1}') || true
  if [ -n "$id" ]; then
    w=$(qstat -f "$id" 2>/dev/null |
        sed -n 's/.*Resource_List\.walltime = \([0-9:]*\).*/\1/p' | head -1)
  fi
  [ -n "${w:-}" ] || w=$(sed -n 's/^#PBS -l walltime=\([0-9:]*\).*/\1/p' "$JOB" | head -1)
  [ -n "$w" ] || return 1
  IFS=: read -r h m _ <<<"$w"
  echo $(( 10#$h * 60 + 10#$m ))
}

# One row per running job: id, name, state, elapsed.
job_rows() {
  command -v qstat >/dev/null 2>&1 || return 1
  local id name state elapsed full
  # -w stops the id being truncated with a trailing *, which qstat -f rejects as
  # an illegally formed job identifier. It still cuts names past 15 characters
  # (hoop-teacher2-share25 and hoop-teacher2-level1 both read hoop-teacher2-*),
  # so take the name from qstat -f.
  qstat -u "$USER" -w 2>/dev/null | grep -E '^[0-9]+\.' | awk '{print $1, $4, $10, $11}' |
    while read -r id name state elapsed; do
      full=$(qstat -f "$id" 2>/dev/null | sed -n 's/^ *Job_Name = //p')
      echo "$id ${full:-$name} $state $elapsed"
    done
}

# Highest eta across the last progress line of every seed log, in minutes.
max_eta_min() {
  local name=${1:-$(name_default)}
  local log line eta best=''
  for log in runs/"${name}"_s*.log; do
    [ -e "$log" ] || return 1
    line=$(grep '^progress' "$log" 2>/dev/null | tail -1) || true
    [ -n "$line" ] || continue
    # A log from an older run would drag the eta to whatever it finished at.
    [ $(( ($(date +%s) - $(stat -c %Y "$log")) / 60 )) -lt 10 ] || continue
    eta=$(sed -n 's/.*eta \([0-9]*\)m.*/\1/p' <<<"$line")
    [ -n "$eta" ] || continue
    # A chained [ ] || [ ] && ... returns non-zero here and set -e would exit.
    if [ -z "$best" ] || [ "$eta" -gt "$best" ]; then
      best=$eta
    fi
  done
  [ -n "$best" ] || return 1
  echo "$best"
}

# --- commands ---------------------------------------------------------------

cmd_setup() {
  bash hpc/setup.sh
}

cmd_run() {  # local or interactive training
  need_venv
  local seeds=${1:-5} steps=${2:-500000} name=${3:-sac}
  shift $(( $# < 3 ? $# : 3 ))
  bash hpc/run_seeds.sh "$name" "$seeds" "$steps" "$@"
}

# A screening run: 2 seeds, 800k steps, 4 environments each. About 1.5 hours.
# 8 cores in all, since medq nodes rarely have 16 free and a 16-core job waits.
# It answers one question, whether the reward works, before a full run pays for it.
# Judge it on two numbers only: `wall` under 20%, and `level` above 0.
cmd_screen() {
  local name=${1:?usage: ds screen <name> [train options]}
  shift
  cmd_submit 2 800000 "$name" --envs 4 "$@"
}

# The policy input's length, which sets how fast a seed trains and how much memory
# its replay buffer takes. 109 if the venv cannot say.
input_dim() {
  have_venv && "$PY" -c 'from src import contract; print(contract.POLICY_INPUT_DIM)' 2>/dev/null || echo 109
}

# Steps a second for one seed on one environment: 86 measured with the 109-input
# layout, ~60 with the 430-input slotted history (10k steps took 1.4x as long).
steps_per_s() { [ "$(input_dim)" -gt 200 ] && echo 60 || echo 86; }

# Memory for the job, in GB. Each seed's 1M-step replay buffer holds two float32
# copies of the input a step (3.4 GB at 430 inputs, 0.9 GB at 109), plus the demo
# buffer and the process; 16 GB is the floor every job has had.
mem_for() {
  local seeds=$1 gb
  gb=$(( (seeds * ($(input_dim) * 11 + 600) + 999) / 1000 ))
  [ "$gb" -lt 16 ] && gb=16
  echo "${gb}GB"
}

# Wall minutes one seed needs, plus a quarter. Seeds run in parallel on their
# own cores, so the count does not change the wall time. steps_per_s is measured
# on one environment. Parallel environments speed a seed up, and the second
# argument counts them. Half-linear, because the gradient steps do not shrink.
walltime_for() {
  local steps=$1 envs=${2:-1} mins
  mins=$(( steps * 125 / ($(steps_per_s) * 60 * 100) ))
  [ "$envs" -gt 1 ] && mins=$(( mins * 2 / envs ))
  [ "$mins" -lt 30 ] && mins=30
  printf '%02d:%02d:00' $(( mins / 60 )) $(( mins % 60 ))
}

cmd_submit() {
  need_qsub
  have_venv || warn "no .venv on this machine. The job fails unless you ran ./ds setup here."
  local seeds=${1:-4} steps=${2:-2000000} name=${3:-sac}
  shift $(( $# < 3 ? $# : 3 ))   # the rest are train options, e.g. --randomise --level 0.75
  # Two runs under one name put their logs in one glob, and nothing downstream
  # can separate them again.
  if compgen -G "runs/${name}_s*.log" >/dev/null; then
    warn "runs/${name}_s*.log already exists. Pick a new name, or the logs mix."
  fi
  mkdir -p runs && printf '%s\n' "$name" > "$LAST"
  # Always rewrite, so a reused name never inherits an older run's options.
  if [ $# -gt 0 ]; then printf '%s\n' "$@"; fi > "runs/${name}.args"
  queue "$name" "$seeds" "$steps" "$(walltime_for "$steps" "$(envs_for "$name")")"
}

# Cores one seed needs: one per --envs in runs/<name>.args, else one.
envs_for() {
  local name=$1 args="runs/$1.args" n=1 prev=""
  if [ -f "$args" ]; then
    while IFS= read -r arg; do
      case "$prev" in --env|--envs) n="$arg" ;; esac
      case "$arg" in --env=*|--envs=*) n="${arg#*=}" ;; esac
      prev="$arg"
    done < "$args"
  fi
  printf '%s' "$n"
}

# qsub the job for a run whose options are already in runs/<name>.args.
queue() {
  local name=$1 seeds=$2 steps=$3 wall=$4 cpus
  cpus=$(( seeds * $(envs_for "$name") ))
  # -l and -N on the command line beat the #PBS lines in the job file, so the
  # walltime always matches the step count. ncpus must cover every seed's envs.
  qsub -N "hoop-$name" \
       -l "ncpus=${cpus},mem=$(mem_for "$seeds"),walltime=${wall}" \
       -v "DS_NAME=${name},DS_SEEDS=${seeds},DS_STEPS=${steps}" \
       "$JOB"
  printf '%s%s seeds, %s steps, %s cores, %s, walltime %s, options [%s], logs runs/%s_s*.log%s\n' \
    "$D" "$seeds" "$steps" "$cpus" "$(mem_for "$seeds")" "$wall" "$(paste -sd' ' "runs/${name}.args")" "$name" "$N"
}

# Resubmit a run that was cut off. Each seed carries on from its last snapshot
# in runs/<name>_s<seed>/resume/, with the same options and total step count,
# and the walltime only covers the steps left for the slowest seed.
cmd_resume() {
  need_qsub
  local name=${1:-$(name_default)} seeds=0 total=0 least=-1 state steps
  while [ -e "runs/${name}_s${seeds}.log" ]; do
    state="runs/${name}_s${seeds}/resume/state.json"
    [ -f "$state" ] || die "no $state. That seed never reached a checkpoint, so start it again with ./ds submit."
    steps=$(sed -n 's/.*"steps": \([0-9]*\).*/\1/p' "$state")
    total=$(sed -n 's/.*"total": \([0-9]*\).*/\1/p' "$state")
    if [ "$least" -lt 0 ] || [ "$steps" -lt "$least" ]; then least=$steps; fi
    seeds=$((seeds + 1))
  done
  [ "$seeds" -gt 0 ] || die "no logs in runs/ for '$name'"
  [ "$least" -lt "$total" ] || die "every seed of '$name' already reached $total steps"
  touch "runs/${name}.args"
  grep -qx -- --resume "runs/${name}.args" || echo --resume >> "runs/${name}.args"
  printf '%s\n' "$name" > "$LAST"
  printf '%sresuming from step %s of %s%s\n' "$D" "$least" "$total" "$N"
  queue "$name" "$seeds" "$total" "$(walltime_for $(( total - least )) "$(envs_for "$name")")"
}

cmd_progress() {
  bash hpc/progress.sh "${1:-$(name_default)}"
}

cmd_report() {  # settings, results and flags; works on a running job too
  need_venv
  "$PY" -m src.report "${1:-$(name_default)}"
}

cmd_logs() {
  local seed=${1:-0}
  local name=${2:-$(name_default)}
  local log="runs/${name}_s${seed}.log"
  [ -e "$log" ] || die "no log at $log"
  tail -f "$log"
}

cmd_test() {
  need_venv
  "$PY" -m pytest -q
}

cmd_cancel() {
  need_qsub
  local id=${1:-}
  [ -n "$id" ] || die "usage: ./ds cancel <jobid>"
  qdel "$id"
}

# Claude designs and submits the next MDP whenever a run finishes (hpc/autopilot.sh).
# It can change only R_* / GAMMA / reward() in src/contract.py; code enforces that.
AUTOPILOT_CRON="*/20 * * * * bash $PWD/hpc/autopilot.sh >> $PWD/runs/autopilot/cron.log 2>&1"
cmd_autopilot() {
  local ap=runs/autopilot
  mkdir -p "$ap" && touch "$ap/launched"
  case "${1:-status}" in
    install)
      command -v crontab >/dev/null || die "no crontab here"
      { crontab -l 2>/dev/null | grep -vF "hpc/autopilot.sh" || true; echo "$AUTOPILOT_CRON"; } | crontab -
      rm -f "$ap/STOP"
      printf 'installed: every 20 min on %s. It waits for the running job, then takes over.\n' "$(hostname)" ;;
    uninstall)
      { crontab -l 2>/dev/null | grep -vF "hpc/autopilot.sh" || true; } | crontab -
      echo "removed from crontab" ;;
    stop)    touch "$ap/STOP"; echo "stopped; ./ds autopilot resume to carry on" ;;
    resume)  rm -f "$ap/STOP" "$ap/FAILED"; echo "resumed" ;;
    dry)     # a fresh state dir each time, so repeated test rounds never hit the attempt limit
             [ -d runs/autopilot-dry ] && chmod -R u+w runs/autopilot-dry && rm -rf runs/autopilot-dry
             DRY_RUN=1 AUTOPILOT_LAST="${2:?usage: ds autopilot dry <finished run>}" bash hpc/autopilot.sh ;;
    status)
      if crontab -l 2>/dev/null | grep -qF "hpc/autopilot.sh"; then
        printf '%scron%s      installed on %s\n' "$G" "$N" "$(hostname)"
      else
        printf '%scron%s      not installed (./ds autopilot install)\n' "$Y" "$N"
      fi
      [ -e "$ap/STOP" ] && printf '%sstopped%s   ./ds autopilot resume\n' "$Y" "$N"
      [ -e "$ap/FAILED" ] && printf '%sFAILED%s    %s\n' "$R" "$N" "$(cat "$ap/FAILED")"
      printf 'launched  %s of %s: %s\n' "$(wc -l < "$ap/launched")" "${MAX_RUNS:-5}" \
        "$(paste -sd' ' "$ap/launched")"
      printf 'watching  %s\n' "$(name_default)"
      if [ -s "$ap/autopilot.log" ]; then echo; tail -5 "$ap/autopilot.log"; fi ;;
    *) die "usage: ./ds autopilot [status|install|uninstall|stop|resume|dry <run>]" ;;
  esac
}

cmd_vpn() {
  [ -x scripts/uts-vpn.sh ] || die "scripts/uts-vpn.sh is missing"
  bash scripts/uts-vpn.sh "$@"
}

# Progress and walltime headroom for one run. The job row is optional, since a
# run started with ./ds run has logs but no qstat entry.
status_run() {
  local name=$1 row=${2:-} id elapsed eta total remaining elapsed_min=0 h m
  printf '\n%sprogress%s  %s\n' "$B" "$N" "$name"
  if bash hpc/progress.sh "$name" 2>/dev/null | sed 's/^/  /'; then :; else
    printf '  %sno logs yet%s\n' "$D" "$N"
  fi

  # Compare the slowest seed against the walltime left, and say so plainly.
  id=$(awk '{print $1}' <<<"$row")
  eta=$(max_eta_min "$name") || return 0
  total=$(walltime_min "$id") || return 0
  if [ -n "$row" ]; then
    # qstat prints HH:MM, qstat -w prints HH:MM:SS. Read three fields either
    # way, or the seconds land in $m and the arithmetic sees "11:10".
    IFS=: read -r h m _ <<<"$(awk '{print $4}' <<<"$row")"
    if [[ ${h:-} =~ ^[0-9]+$ && ${m:-} =~ ^[0-9]+$ ]]; then
      elapsed_min=$(( 10#$h * 60 + 10#$m ))
    fi
  fi
  remaining=$(( total - elapsed_min ))
  printf '  %swalltime%s  slowest seed needs %sm, %sm of %sm left\n' "$B" "$N" "$eta" "$remaining" "$total"
  if [ "$eta" -gt "$remaining" ]; then
    printf '  %sthe job runs out of walltime. Raise walltime in %s, or cut --steps.%s\n' "$R" "$JOB" "$N"
  else
    printf '  %sfits%s\n' "$G" "$N"
  fi
}

# With a name, report that run. Without one, report every queued or running
# job (its run name is the job name minus the hoop- prefix ds submit adds),
# falling back to the last submission when nothing is in the queue.
cmd_status() {
  local rows='' row jname
  printf '%sjobs%s\n' "$B" "$N"
  if rows=$(job_rows) && [ -n "$rows" ]; then
    sed 's/^/  /' <<<"$rows"
  elif command -v qstat >/dev/null 2>&1; then
    printf '  %snone queued or running%s\n' "$D" "$N"
  else
    printf '  %sno qstat here, so this is not the HPC%s\n' "$D" "$N"
  fi

  if [ -n "${1:-}" ]; then
    status_run "$1" "$(awk -v n="hoop-$1" '$2==n' <<<"$rows" | head -1)"
  elif [ -n "$rows" ]; then
    while read -r row <&3; do
      jname=$(awk '{print $2}' <<<"$row")
      status_run "${jname#hoop-}" "$row"
    done 3<<<"$rows"
  else
    status_run "$(name_default)"
  fi
}

# Your jobs split into running and waiting, so a queued job is never mistaken
# for one that is training. qstat -w columns: 4 name, 9 walltime asked for,
# 10 state, 11 elapsed.
cmd_queue() {
  command -v qstat >/dev/null 2>&1 || die "no qstat. Run this on the HPC login node."
  local all running waiting
  all=$(qstat -u "$USER" -w 2>/dev/null | grep -E '^[0-9]+\.') || true
  running=$(awk '$10=="R" || $10=="E"' <<<"$all")
  waiting=$(awk '$10!="R" && $10!="E"' <<<"$all")

  printf '%srunning%s\n' "$G$B" "$N"
  if [ -n "$running" ]; then
    awk '{printf "  %-20s %-24s elapsed %s of %s\n", $1, $4, $11, $9}' <<<"$running"
  else
    printf '  %snone%s\n' "$D" "$N"
  fi

  printf '\n%squeued%s\n' "$Y$B" "$N"
  if [ -n "$waiting" ]; then
    # Q waits for resources, H is held, W waits for its start time.
    awk '{s=$10; r=(s=="Q")?"waiting":(s=="H")?"held":(s=="W")?"waiting for start time":"state " s;
          printf "  %-20s %-24s %s, walltime %s\n", $1, $4, r, $9}' <<<"$waiting"
  else
    printf '  %snone%s\n' "$D" "$N"
  fi
}

banner() {
  local branch venv rows
  branch=$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo "no git")
  if have_venv; then
    venv="${G}ok${N}  $("$PY" --version 2>&1)"
  else
    venv="${Y}missing${N} - run ./ds setup"
  fi
  printf '\n%sDroneSoccer%s  %s%s%s\n' "$B" "$N" "$D" "$branch" "$N"
  printf '  venv  %s\n' "$venv"
  if rows=$(job_rows) && [ -n "$rows" ]; then
    printf '  jobs  %s\n' "$(head -1 <<<"$rows")"
  fi
  cat <<EOF

  ${B}setup${N}     build .venv, once per machine
  ${B}run${N}       train here: ./ds run [seeds] [steps] [name] [train options]
  ${B}submit${N}    qsub a job: ./ds submit [seeds] [steps] [name] [train options]
  ${B}screen${N}    cheap check of a reward change: ./ds screen <name> (2 seeds, 800k, 4 envs)
  ${B}resume${N}    resubmit a cut-off run from its snapshots: ./ds resume [name]
  ${B}status${N}    jobs, progress and walltime headroom
  ${B}queue${N}     your jobs, running and queued
  ${B}progress${N}  one line per seed
  ${B}report${N}    settings, results and flags: ./ds report [name] (also in trainingReports/)
  ${B}logs${N}      follow a seed: ./ds logs [seed]
  ${B}test${N}      pytest
  ${B}cancel${N}    qdel a job: ./ds cancel <jobid>
  ${B}autopilot${N} Claude submits the next MDP after each run: ./ds autopilot [status|install|stop|resume|dry <run>]
  ${B}vpn${N}       connect the UTS VPN

EOF
}

case "${1:-}" in
  ''|-h|--help|help) banner ;;
  setup|run|submit|screen|resume|progress|report|status|queue|logs|test|cancel|autopilot|vpn)
    cmd="$1"; shift; "cmd_$cmd" "$@" ;;
  *) die "unknown command: $1  (run ./ds for the list)" ;;
esac
